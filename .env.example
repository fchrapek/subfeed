# Copy to .env and fill in. Used by `npm run dev` / `npm start` and by compose.yaml.

# Output of `npm run hash-password` (or, with Docker:
# `docker run --rm -it subfeed node scripts/hash-password.mjs`).
SUBFEED_PASSWORD_HASH=

# The exact address you open Subfeed at: scheme and host, no trailing slash.
# Plain http is only accepted for localhost. For `npm run dev` use
# http://localhost:5173.
SUBFEED_ORIGIN=https://subfeed.example.com

# Optional
# SUBFEED_DB=./server/db.sqlite
# PORT=8787
